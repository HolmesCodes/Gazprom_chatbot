# === LLM через Polza.ai (API) ===
LLM_API_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=pza_ваш_ключ_здесь
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_PROVIDER=openai

# === Эмбеддинги ===
# "api" — через Polza.ai (baai/bge-m3)
# "ollama" — локально через Ollama (nomic-embed-text)
EMBEDDING_MODE=api
EMBEDDING_MODEL=baai/bge-m3

# === Ollama (только если EMBEDDING_MODE=ollama) ===
OLLAMA_BASE_URL=http://localhost:11434

# === STT через Polza.ai (API) ===
WHISPER_MODEL=whisper-1

# === Пути ===
DOCUMENTS_DIR=data/documents
CHROMA_DIR=chroma_db

# === Сервер ===
API_HOST=127.0.0.1
API_PORT=8000
