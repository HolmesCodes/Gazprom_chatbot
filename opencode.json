{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash-free",
  "small_model": "deepseek/deepseek-v4-flash-free",
  "default_agent": "build",
  "agent": {
    "opus": {
      "model": "lightning-zeus/claude-opus-4-6",
      "mode": "subagent",
      "description": "Use ONLY for complex architecture, planning, and critical review. Has limited requests — batch all work into one @opus call.",
      "steps": 50,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
