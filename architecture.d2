title: {
  label: "Factory Assistant — Архитектура RAG-системы"
  style.font-size: 32
  style.font-color: "#1a1a2e"
  style.bold: true
}

direction: down

# ─── ЛЕГЕНДА ────────────────────────────────────────────────
Legend: Легенда {
  style.fill: "#f8f9fa"
  style.stroke: "#dee2e6"
  style.border-radius: 8
  style.font-size: 13

  row1: "Фронтенд" {style.fill: "#3b82f6"; style.font-color: white; style.border-radius: 4}
  row2: "API-сервер" {style.fill: "#1e293b"; style.font-color: white; style.border-radius: 4}
  row3: "Бизнес-логика" {style.fill: "#059669"; style.font-color: white; style.border-radius: 4}
  row4: "RAG / ML" {style.fill: "#7c3aed"; style.font-color: white; style.border-radius: 4}
  row5: "Хранилище" {style.fill: "#d97706"; style.font-color: white; style.border-radius: 4}
  row6: "Внешние сервисы" {style.fill: "#dc2626"; style.font-color: white; style.border-radius: 4}
}

# ─── 1. ПОЛЬЗОВАТЕЛЬ ──────────────────────────────────────
User: Пользователь {
  shape: person
  style.font-size: 16
  style.font-color: "#1a1a2e"
  style.fill: "#e0f2fe"
  style.stroke: "#3b82f6"
  style.border-radius: 50
}

# ─── 2. ФРОНТЕНД ──────────────────────────────────────────
Frontend: Веб-интерфейс (SPA) {
  style.fill: "#eff6ff"
  style.stroke: "#3b82f6"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: "#1e40af"

  chat: Чат {
    style.fill: "#3b82f6"
    style.font-color: white
    style.border-radius: 8
    style.font-size: 14
  }
  welcome: Приветствие {
    style.fill: "#60a5fa"
    style.font-color: white
    style.border-radius: 8
    style.font-size: 14
  }
  onboarding: Онбординг {
    style.fill: "#60a5fa"
    style.font-color: white
    style.border-radius: 8
    style.font-size: 14
  }
  left_panel: Левая панель {
    style.fill: "#93c5fd"
    style.font-color: white
    style.border-radius: 8
    style.font-size: 14
  }
}

# ─── 3. API-СЛОЙ ──────────────────────────────────────────
API: FastAPI + Uvicorn {
  style.fill: "#1e293b"
  style.stroke: "#0f172a"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: white

  ask: "POST /api/ask" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
  reindex: "POST /admin/reindex" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
  upload: "POST /admin/documents/upload" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
  config: "PATCH /admin/config" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
  onboarding: "POST /onboarding/*" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
  health: "GET /health" {style.fill: "#334155"; style.font-color: "#e2e8f0"; style.border-radius: 6; style.font-size: 12}
}

# ─── 4. БИЗНЕС-ЛОГИКА ─────────────────────────────────────
Service: FactoryAssistantService {
  style.fill: "#059669"
  style.stroke: "#047857"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: white

  ask_method: ask() {style.fill: "#10b981"; style.font-color: white; style.border-radius: 8; style.font-size: 14}
  transcribe_method: transcribe() {style.fill: "#34d399"; style.font-color: white; style.border-radius: 8; style.font-size: 14}
  reindex_method: reindex() {style.fill: "#34d399"; style.font-color: white; style.border-radius: 8; style.font-size: 14}
  onb_start: start_onboarding() {style.fill: "#6ee7b7"; style.font-color: "#065f46"; style.border-radius: 8; style.font-size: 14}
  onb_msg: onboarding_message() {style.fill: "#6ee7b7"; style.font-color: "#065f46"; style.border-radius: 8; style.font-size: 14}
}

# ─── 5. RAG / ML ──────────────────────────────────────────
Rag: RagEngine {
  style.fill: "#7c3aed"
  style.stroke: "#6d28d9"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: white

  retriever: "MMR-ретвивер" {style.fill: "#8b5cf6"; style.font-color: white; style.border-radius: 8; style.font-size: 14; shape: cylinder}
  llm_chain: "LLM Chain" {style.fill: "#a78bfa"; style.font-color: white; style.border-radius: 8; style.font-size: 14}
  relevance: "Relevance Scoring" {style.fill: "#c4b5fd"; style.font-color: "#4c1d95"; style.border-radius: 8; style.font-size: 14; shape: hexagon}
  image_filter: "Image Filter" {style.fill: "#c4b5fd"; style.font-color: "#4c1d95"; style.border-radius: 8; style.font-size: 14; shape: hexagon}
}

Onboarding: OnboardingManager {
  style.fill: "#7c3aed"
  style.stroke: "#6d28d9"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 16
  style.bold: true
  style.font-color: white

  step_list: "Чеклист (9 шагов)" {style.fill: "#a78bfa"; style.font-color: white; style.border-radius: 8; style.font-size: 13}
  onboard_llm: "LLM → Polza.ai" {style.fill: "#c4b5fd"; style.font-color: "#4c1d95"; style.border-radius: 8; style.font-size: 13}
}

# ─── 6. ХРАНИЛИЩЕ ─────────────────────────────────────────
Chroma: ChromaDB {
  style.fill: "#d97706"
  style.stroke: "#b45309"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: white

  docs_collection: "factory_docs" {style.fill: "#f59e0b"; style.font-color: "#78350f"; style.border-radius: 8; style.font-size: 14; shape: document}
}

Docs: Документы {
  style.fill: "#16a085"
  style.stroke: "#138d75"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 16
  style.bold: true
  style.font-color: white

  pdf: PDF {style.fill: "#1abc9c"; style.font-color: white; style.border-radius: 6; style.font-size: 13}
  docx: DOCX {style.fill: "#48c9b0"; style.font-color: white; style.border-radius: 6; style.font-size: 13}
  txt: TXT {style.fill: "#76d7c4"; style.font-color: "#0e6655"; style.border-radius: 6; style.font-size: 13}
  md: Markdown {style.fill: "#a3e4d7"; style.font-color: "#0e6655"; style.border-radius: 6; style.font-size: 13}
}

Ingest: Ingest Pipeline {
  style.fill: "#16a085"
  style.stroke: "#138d75"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 16
  style.bold: true
  style.font-color: white

  loader: "_loader_for()" {style.fill: "#1abc9c"; style.font-color: white; style.border-radius: 6; style.font-size: 12}
  clean: "_clean_pdf_text()" {style.fill: "#1abc9c"; style.font-color: white; style.border-radius: 6; style.font-size: 12}
  enrich: "_enrich_metadata()" {style.fill: "#48c9b0"; style.font-color: white; style.border-radius: 6; style.font-size: 12}
  split: "TextSplitter\nchunk=1500 overlap=200" {style.fill: "#76d7c4"; style.font-color: "#0e6655"; style.border-radius: 6; style.font-size: 11}
  loader -> clean -> enrich -> split
}

# ─── 7. ВНЕШНИЕ СЕРВИСЫ ────────────────────────────────────
Polza: Polza.ai {
  style.fill: "#dc2626"
  style.stroke: "#b91c1c"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 18
  style.bold: true
  style.font-color: white

  llm: "deepseek/deepseek-v4-flash" {style.fill: "#ef4444"; style.font-color: white; style.border-radius: 8; style.font-size: 13; shape: oval}
  stt: "openai/whisper-1" {style.fill: "#f87171"; style.font-color: white; style.border-radius: 8; style.font-size: 13; shape: oval}
}

Ollama: Ollama (локально) {
  style.fill: "#dc2626"
  style.stroke: "#b91c1c"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 16
  style.bold: true
  style.font-color: white

  embeddings: "nomic-embed-text" {style.fill: "#ef4444"; style.font-color: white; style.border-radius: 8; style.font-size: 13; shape: oval}
}

# ─── 8. CLI ────────────────────────────────────────────────
CLI: CLI {
  style.fill: "#6b7280"
  style.stroke: "#4b5563"
  style.stroke-width: 2
  style.border-radius: 12
  style.font-size: 16
  style.bold: true
  style.font-color: white

  serve: "factory serve" {style.fill: "#9ca3af"; style.font-color: "#1f2937"; style.border-radius: 6; style.font-size: 12}
  ingest_cmd: "factory ingest" {style.fill: "#9ca3af"; style.font-color: "#1f2937"; style.border-radius: 6; style.font-size: 12}
  ask_cmd: "factory ask" {style.fill: "#9ca3af"; style.font-color: "#1f2937"; style.border-radius: 6; style.font-size: 12}
}

# ════════════════════════════════════════════════════════════
# СВЯЗИ
# ════════════════════════════════════════════════════════════

User -> Frontend
Frontend -> API: "HTTP fetch /api/*" {style.stroke: "#3b82f6"; style.font-size: 12; style.stroke-width: 2}
API -> Service: "вызов методов" {style.stroke: "#059669"; style.font-size: 12; style.stroke-width: 2}
Service -> Rag: "ask() / reindex()" {style.stroke: "#7c3aed"; style.font-size: 12; style.stroke-width: 2}
Service -> Onboarding: "start/message()" {style.stroke: "#7c3aed"; style.font-size: 12; style.stroke-width: 2; style.stroke-dash: 4}

Rag -> Polza: "ChatOpenAI\n(LLM)" {style.stroke: "#dc2626"; style.font-size: 11; style.stroke-width: 2}
Rag -> Ollama: "OllamaEmbeddings" {style.stroke: "#dc2626"; style.font-size: 11; style.stroke-width: 2; style.stroke-dash: 4}
Rag -> Chroma: "similarity_search\nMMR k=5" {style.stroke: "#d97706"; style.font-size: 11; style.stroke-width: 2}
Chroma -> Docs: "read chunks" {style.stroke: "#16a085"; style.font-size: 11; style.stroke-width: 1; style.stroke-dash: 4}
Docs -> Ingest: "PDF/DOCX/TXT/MD" {style.stroke: "#16a085"; style.font-size: 11; style.stroke-width: 2}
Ingest -> Chroma: "add_documents" {style.stroke: "#d97706"; style.font-size: 11; style.stroke-width: 2}
CLI -> Service: "CLI" {style.stroke: "#6b7280"; style.font-size: 11; style.stroke-width: 1; style.stroke-dash: 4}
CLI -> Ingest: "CLI" {style.stroke: "#6b7280"; style.font-size: 11; style.stroke-width: 1; style.stroke-dash: 4}
